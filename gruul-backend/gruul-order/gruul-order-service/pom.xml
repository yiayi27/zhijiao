<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.medusa</groupId>
        <artifactId>gruul-order</artifactId>
        <version>1.0</version>
    </parent>

    <artifactId>gruul-order-service</artifactId>
    <packaging>jar</packaging>
    <version>1.0</version>
    <description>order 订单模块</description>

    <dependencies>
        <!--订单api模块-->
        <dependency>
            <groupId>com.medusa</groupId>
            <artifactId>gruul-order-api</artifactId>
            <version>${gruul.version}</version>
        </dependency>
        <!--账户api模块-->
        <dependency>
            <groupId>com.medusa</groupId>
            <artifactId>gruul-account-api</artifactId>
            <version>${gruul.version}</version>
        </dependency>
        <!--platform api 模块-->
        <dependency>
            <groupId>com.medusa</groupId>
            <artifactId>gruul-platform-api</artifactId>
            <version>${gruul.version}</version>
        </dependency>
        <!--物流内服api模块-->
        <dependency>
            <groupId>com.medusa</groupId>
            <artifactId>gruul-logistics-api</artifactId>
            <version>${gruul.version}</version>
        </dependency>
        <!--积分商城api模块-->
        <dependency>
            <groupId>com.medusa</groupId>
            <artifactId>gruul-integral-api</artifactId>
            <version>${gruul.version}</version>
        </dependency>
        <!--促销api模块-->
        <dependency>
            <groupId>com.medusa</groupId>
            <artifactId>gruul-discount-api</artifactId>
            <version>${gruul.version}</version>
        </dependency>
        <!-- 支付api模块-->
        <dependency>
            <groupId>com.medusa</groupId>
            <artifactId>gruul-payment-api</artifactId>
            <version>${gruul.version}</version>
        </dependency>
        <!-- 平台api模块-->
        <dependency>
            <groupId>com.medusa</groupId>
            <artifactId>gruul-platform-api</artifactId>
            <version>${gruul.version}</version>
        </dependency>
        <!--商品api模块-->
        <dependency>
            <groupId>com.medusa</groupId>
            <artifactId>gruul-goods-api</artifactId>
            <version>${gruul.version}</version>
        </dependency>
        <!--财务api模块-->
        <dependency>
            <groupId>com.medusa</groupId>
            <artifactId>gruul-finance-api</artifactId>
            <version>${gruul.version}</version>
        </dependency>
        <!--数据库-->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
        <!--RocketMQ-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <!--    module service    -->
        <dependency>
            <groupId>com.medusa</groupId>
            <artifactId>gruul-common-module-service</artifactId>
        </dependency>
        <!--   wx java miniapp     -->
        <dependency>
            <groupId>com.github.binarywang</groupId>
            <artifactId>weixin-java-miniapp</artifactId>
            <version>${wxjava.version}</version>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>