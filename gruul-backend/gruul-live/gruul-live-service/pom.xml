<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.medusa</groupId>
        <artifactId>gruul-live</artifactId>
        <version>1.0</version>
    </parent>

    <artifactId>gruul-live-service</artifactId>
    <packaging>jar</packaging>

    <description>gruul 直播模块</description>
    <dependencies>
        <!--api模块-->
        <dependency>
            <groupId>com.medusa</groupId>
            <artifactId>gruul-live-api</artifactId>
            <version>${gruul.version}</version>
        </dependency>
        <!--物流模块-->
        <dependency>
            <groupId>com.medusa</groupId>
            <artifactId>gruul-logistics-api</artifactId>
            <version>${gruul.version}</version>
        </dependency>
        <!--支付模块-->
        <dependency>
            <groupId>com.medusa</groupId>
            <artifactId>gruul-payment-api</artifactId>
            <version>${gruul.version}</version>
        </dependency>
        <!--用户api模块-->
        <dependency>
            <groupId>com.medusa</groupId>
            <artifactId>gruul-account-api</artifactId>
            <version>${gruul.version}</version>
        </dependency>
        <!-- 平台api -->
        <dependency>
            <groupId>com.medusa</groupId>
            <artifactId>gruul-platform-api</artifactId>
            <version>${gruul.version}</version>
        </dependency>
        <!--订单api模块-->
        <dependency>
            <groupId>com.medusa</groupId>
            <artifactId>gruul-order-api</artifactId>
            <version>${gruul.version}</version>
        </dependency>
        <!--数据库-->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
        <!--   module service     -->
        <dependency>
            <groupId>com.medusa</groupId>
            <artifactId>gruul-common-module-service</artifactId>
        </dependency>
        <!--RocketMQ-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>


</project>