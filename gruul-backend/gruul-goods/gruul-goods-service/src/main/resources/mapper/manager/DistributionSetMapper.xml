<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.medusa.gruul.goods.mapper.manager.DistributionSetMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.medusa.gruul.goods.api.entity.DistributionSet">
        <id column="id" property="id"/>
        <result column="product_id" property="productId"/>
        <result column="sku_id" property="skuId"/>
        <result column="first_commission" property="firstCommission"/>
        <result column="second_commission" property="secondCommission"/>
        <result column="third_commission" property="thirdCommission"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        create_time,
        update_time,
        is_deleted,
        id, product_id, sku_id, first_commission, second_commission, third_commission
    </sql>

    <select id="getByProductId" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from t_distribution_set
        where product_id = #{productId}
    </select>

</mapper>
