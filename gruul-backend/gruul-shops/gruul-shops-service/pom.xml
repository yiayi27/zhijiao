<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.medusa</groupId>
        <artifactId>gruul-shops</artifactId>
        <version>1.0</version>
    </parent>

    <artifactId>gruul-shops-service</artifactId>
    <packaging>jar</packaging>
    <description>店铺服务模块</description>

    <dependencies>

        <!-- 店铺api模块-->
        <dependency>
            <groupId>com.medusa</groupId>
            <artifactId>gruul-shops-api</artifactId>
            <version>${gruul.version}</version>
        </dependency>
        <!-- 用户api模块-->
        <dependency>
            <groupId>com.medusa</groupId>
            <artifactId>gruul-account-api</artifactId>
            <version>${gruul.version}</version>
        </dependency>
        <!-- sms -->
        <dependency>
            <groupId>com.medusa</groupId>
            <artifactId>gruul-sms-api</artifactId>
            <version>${gruul.version}</version>
        </dependency>

        <dependency>
            <groupId>com.medusa</groupId>
            <artifactId>gruul-payment-api</artifactId>
            <version>${gruul.version}</version>
        </dependency>

        <!-- 积分模块-->
        <dependency>
            <groupId>com.medusa</groupId>
            <artifactId>gruul-integral-api</artifactId>
            <version>${gruul.version}</version>
        </dependency>

        <!--数据库-->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
        <!--RocketMQ-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <!--  module service      -->
        <dependency>
            <groupId>com.medusa</groupId>
            <artifactId>gruul-common-module-service</artifactId>
        </dependency>

        <!--  global-model service      -->
        <dependency>
            <groupId>com.medusa</groupId>
            <artifactId>gruul-common-global-model</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>


</project>
