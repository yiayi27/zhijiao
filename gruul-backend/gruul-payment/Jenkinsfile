 pipeline {

    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '2'))
        skipDefaultCheckout true
    }

    environment {
       PROJECT_VERSION = sh(script:
                                 "curl -s curl http://101.71.90.254:8020" +
                                 "/xiaoq/version_control/raw/master/gruul-${BRANCH_NAME}.test",
                                 returnStdout: true).trim() // 项目版本, 公共基础库为 public
       EVN = "-e SPRING_CLOUD_NACOS_DISCOVERY_METADATA_VERSION=${PROJECT_VERSION} "
       DOCKER_REGISTRY = "101.71.90.254:81" //镜像上传选地址
       IMAGE_NAME = "gruul/gruul-payment"
       MODEL_NAME = "gruul-payment"
       SERVICE_NAME = "${MODEL_NAME}-${PROJECT_VERSION}"
       IMAGE_VERSION = "${BRANCH_NAME}-${PROJECT_VERSION}"
       DEV_NODE = "node-1"
       TEST_NODE = "node-2"
       PORT = "9350"
    }

    stages {
        stage('check out') {

            agent { label 'master'}

            steps {

               checkout scm

               echo "current branch: $BRANCH_NAME"

               echo "$IMAGE_VERSION"

            }

        }

        stage('mvn build & deploy'){

            agent { label 'master'}

            steps {
               withMaven(maven: 'maven3.6.2', mavenSettingsConfig: '3ea105df-717e-4eb7-8f6b-8a429180b140') {
                 sh "mvn clean package -U -Dmaven.test.skip=true deploy"

               }
            }
        }

        stage ('docker build & push') {

            agent { label 'master'}

            steps{

                script {
                        echo 'master branch build & push'

                        docker.withRegistry("http://${DOCKER_REGISTRY}","harbor") {
                            def customImage = docker.build("${IMAGE_NAME}:${IMAGE_VERSION}")
                            customImage.push()
                        }
                }
            }
        }

        //docker部署

         stage ('docker deploy to dev') {

           agent { label "$DEV_NODE"}
            when {
                branch 'master'
            }

            steps{

                echo 'stop old container'

                sh '''CID=$(docker ps -a | grep $MODEL_NAME-${PROJECT_VERSION} | awk \'{print $1}\')
                    if [ "$CID" != "" ];then
                        docker rm -f $CID
                    fi'''

                echo 'remove images'

                sh "docker pull $DOCKER_REGISTRY/$IMAGE_NAME:$IMAGE_VERSION"

                echo 'restart'

                sh "docker run -d --name $SERVICE_NAME  --restart always  -p $PORT:$PORT $EVN  -v /data/pay-certificate:/data/pay-certificate -v /tmp/logs/gruul:/tmp/logs/gruul -e SPRING_PROFILES_ACTIVE=dev $DOCKER_REGISTRY/$IMAGE_NAME:$IMAGE_VERSION"
            }
         }
    }
}
