<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.medusa.gruul.solitaire.mapper.manager.InformationMessageMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.medusa.gruul.solitaire.api.model.vo.manager.InformationMessageVo">
        <id column="id" property="id" />
        <result column="user_id" property="userId" />
        <result column="nick_name" property="nickName" />
        <result column="avatar_url" property="avatarUrl" />
        <result column="info_id" property="infoId" />
        <result column="user_content" property="userContent" />
        <result column="user_send_time" property="userSendTime" />
        <result column="admin_send_time" property="adminSendTime" />
        <result column="admin_content" property="adminContent" />
        <result column="message_type" property="messageType" />
        <result column="sort" property="sort" />
    </resultMap>


    <!-- 通用查询结果列 -->
    <sql id="Base_Page_List">
        id, nick_name, avatar_url, user_content, user_send_time, admin_send_time, admin_content, message_type, sort
    </sql>

    <select id="queryList" resultMap="BaseResultMap"
            parameterType="com.medusa.gruul.solitaire.api.model.param.manager.InformationMessageParam">
        SELECT
        <include refid="Base_Page_List" />
        FROM
        t_information_message p
        <where>
            p.is_deleted = 0
            and p.info_id = #{informationMessageParam.infoId}
            <if test="informationMessageParam.userContent != null and informationMessageParam.userContent != ''">
                AND p.user_content LIKE CONCAT('%',#{informationMessageParam.userContent},'%')
            </if>
            <if test="informationMessageParam.nickName != null and informationMessageParam.nickName != ''">
                AND p.nick_name LIKE CONCAT('%',#{informationMessageParam.nickName},'%')
            </if>
        </where>
        ORDER BY
        p.sort asc, p.user_send_time desc
    </select>

</mapper>
