<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.medusa.gruul.solitaire.mapper.manager.InformationTopicMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.medusa.gruul.solitaire.api.model.vo.manager.InformationTopicVo">
        <id column="id" property="id" />
        <result column="topic_name" property="topicName" />
        <result column="topic_logo" property="topicLogo" />
        <result column="sort" property="sort" />
        <result column="info_count" property="infoCount" />
    </resultMap>


    <!-- 通用查询结果列 -->
    <sql id="Base_Page_List">
        id, topic_name, topic_logo, sort,
        (select count(*) from t_information_info_topic where topic_id = p.id and is_deleted = 0) as info_count
    </sql>

    <select id="queryList" resultMap="BaseResultMap"
            parameterType="com.medusa.gruul.solitaire.api.model.param.manager.InformationMessageParam">
        SELECT
        <include refid="Base_Page_List" />
        FROM
        t_information_topic p
        <where>
            p.is_deleted = 0
        </where>
        ORDER BY
        p.sort asc
    </select>

</mapper>
