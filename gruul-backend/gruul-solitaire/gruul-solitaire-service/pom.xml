<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.medusa</groupId>
        <artifactId>gruul-solitaire</artifactId>
        <version>1.0</version>
    </parent>

    <properties>
        <wx-tool>3.3.0</wx-tool>
    </properties>

    <artifactId>gruul-solitaire-service</artifactId>
    <packaging>jar</packaging>

    <description>gruul solitaire 模块</description>
    <dependencies>

        <!--api模块-->
        <dependency>
            <groupId>com.medusa</groupId>
            <artifactId>gruul-solitaire-api</artifactId>
            <version>${gruul.version}</version>
        </dependency>

        <dependency>
            <groupId>com.medusa</groupId>
            <artifactId>gruul-account-api</artifactId>
            <version>${gruul.version}</version>
        </dependency>

        <dependency>
            <groupId>com.medusa</groupId>
            <artifactId>gruul-order-api</artifactId>
            <version>${gruul.version}</version>
        </dependency>

        <dependency>
            <groupId>com.medusa</groupId>
            <artifactId>gruul-platform-api</artifactId>
            <version>${gruul.version}</version>
        </dependency>

        <!--数据库-->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
        <!-- emoji处理 -->
        <dependency>
            <groupId>com.vdurmont</groupId>
            <artifactId>emoji-java</artifactId>
            <version>4.0.0</version>
        </dependency>
        <!-- 二维码处理 -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
        </dependency>
        <!-- http网络请求 -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
        </dependency>
        <!--RocketMQ-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <!--   module service    -->
        <dependency>
            <groupId>com.medusa</groupId>
            <artifactId>gruul-common-module-service</artifactId>
        </dependency>
        <!--h2 单元测试-->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>


</project>