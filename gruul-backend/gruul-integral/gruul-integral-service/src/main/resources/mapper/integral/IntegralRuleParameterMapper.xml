<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.medusa.gruul.integral.mapper.IntegralRuleParameterMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.medusa.gruul.integral.api.entity.IntegralRuleParameter">
        <id column="id" property="id"/>
        <result column="is_deleted" property="deleted"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="shop_id" property="shopId"/>
        <result column="integral_rule_id" property="integralRuleId"/>
        <result column="key" property="key"/>
        <result column="value" property="value"/>
        <result column="belong_type" property="belongType"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        tirp.is_deleted,
        tirp.create_time,
        tirp.update_time,
        tirp.id, tirp.integral_rule_id, tirp.key, tirp.value, tirp.belong_type
    </sql>


    <insert id="insertInfo">
        INSERT INTO `t_integral_rule_parameter`
            (`integral_rule_id`, `key`, `value`, `belong_type`,`is_deleted`,`update_time`,`create_time`)
        VALUES
            (
              #{integralRuleParameter.integralRuleId},
              #{integralRuleParameter.key},
              #{integralRuleParameter.value},
              #{integralRuleParameter.belongType},
              #{integralRuleParameter.deleted},
              #{integralRuleParameter.updateTime},
              #{integralRuleParameter.createTime}
            )
    </insert>

