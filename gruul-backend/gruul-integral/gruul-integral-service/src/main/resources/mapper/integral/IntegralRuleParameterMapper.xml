    <delete id="physicsDelete">
      DELETE FROM
        t_integral_rule_parameter
      WHERE
        integral_rule_id = #{integralRuleId}
      AND
        is_deleted = 0
    </delete>


    <select id="getShareIntegral" resultType="com.medusa.gruul.integral.api.entity.IntegralRuleParameter">
        SELECT
        <include refid="Base_Column_List"/>
        FROM
        t_integral_rule_parameter tirp
        WHERE
        tirp.integral_rule_id = #{integralRuleId}
        AND
        tirp.is_deleted = 0
    </select>

    <select id="getSingInTotalDay" resultType="com.medusa.gruul.integral.api.entity.IntegralRuleParameter">

        SELECT
        <include refid="Base_Column_List"/>
        FROM
        t_integral_rule_parameter tirp
        WHERE
        tirp.integral_rule_id = #{integralRuleId}
        AND
        tirp.shop_id = #{shopId}
        AND
        tirp.is_deleted = 0

    </select>

    <select id="getRuleParameterMapper"
            resultType="com.medusa.gruul.integral.api.entity.IntegralRuleParameter">

        SELECT
        <include refid="Base_Column_List"/>
        FROM
        t_integral_rule_parameter tirp
        WHERE
        tirp.integral_rule_id = #{integralRuleId}
        AND
        tirp.`key` = #{dayss}
        AND
        tirp.is_deleted = 0
    </select>


    <select id="getIntegralList" resultType="com.medusa.gruul.integral.api.entity.IntegralRuleParameter">

        SELECT
        <include refid="Base_Column_List"/>
