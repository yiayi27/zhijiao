    </select>


    <select id="getSingInIntegral" resultType="com.medusa.gruul.integral.api.entity.IntegralRuleParameter">
        SELECT
        <include refid="Base_Column_List"/>
        FROM
        t_integral_rule_parameter tirp
        WHERE
        tirp.integral_rule_id = #{integralRuleId}
        AND
        tirp.`key` = #{status}
        AND
        tirp.is_deleted = 0
    </select>

    <select id="getStepConversionIntegral"
            resultType="com.medusa.gruul.integral.api.entity.IntegralRuleParameter">
        SELECT
        <include refid="Base_Column_List"/>
