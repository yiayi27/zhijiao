<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.medusa.gruul.account.mapper.MemberCardPrivilegeMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.medusa.gruul.account.api.entity.MemberCardPrivilege">
        <id column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="shop_id" property="shopId"/>
        <result column="is_deleted" property="deleted"/>
        <result column="update_time" property="updateTime"/>
        <result column="icon" property="icon"/>
        <result column="privilege_name" property="privilegeName"/>
        <result column="illustrate" property="illustrate"/>
        <result column="p_type" property="pType"/>
        <result column="is_allow_del" property="allowDel"/>
        <result column="is_open" property="open"/>
        <result column="is_rule" property="isRule"/>
        <result column="def_value" property="defValue"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_time,
        is_deleted,
        update_time,
        icon, privilege_name, illustrate, p_type, is_allow_del, is_open, is_rule, def_value
    </sql>

    <!-- 通用查询映射结果 -->
    <resultMap id="MemberPrivilegeResultMap" type="com.medusa.gruul.account.model.vo.MemberPrivilegeVo">
        <result column="id" property="id"/>
        <result column="privilege_name" property="privilegeName"/>
        <result column="p_type" property="pType"/>
        <result column="icon" property="icon"/>
        <result column="illustrate" property="illustrate"/>
    </resultMap>

    <select id="selectMemberCardPrivilege" resultMap="MemberPrivilegeResultMap">
        select t.id,t.privilege_name,t.p_type,t.icon, t.illustrate from t_member_card_privilege t
        where
        t.is_deleted = 0 and t.is_open = 1
        <if test="shopId != null and shopId != ''">
            AND t.shop_id = #{shopId}
        </if>
        ORDER BY
        t.create_time
        DESC
    </select>

    <select id="getMemberCardPrivilege" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from t_member_card_privilege t
        where
        t.is_deleted = 0
        <if test="shopId != null and shopId != ''">
            AND t.shop_id = #{shopId}
        </if>
        ORDER BY
        t.create_time
    </select>

</mapper>
