<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.medusa.gruul.account.mapper.MemberPayRuleMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.medusa.gruul.account.api.entity.MemberPayRule">
        <id column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="is_deleted" property="deleted"/>
        <result column="update_time" property="updateTime"/>
        <result column="shop_id" property="shopId"/>
        <result column="state" property="state"/>
        <result column="discount_amount" property="discountAmount"/>
        <result column="pay_amount" property="payAmount"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_time,
        is_deleted,
        update_time,
        shop_id,
        state, discount_amount, pay_amount
    </sql>

    <select id="getMemberPayRule" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from t_member_pay_rule t
        where t.is_deleted = 0
        <if test="shopId != null and shopId != ''">
            AND t.shop_id = #{shopId}
        </if>
    </select>


</mapper>
