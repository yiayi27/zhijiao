<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.medusa.gruul.account.mapper.MemberRegisterFormMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.medusa.gruul.account.api.entity.MemberRegisterForm">
        <id column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="shop_id" property="shopId"/>
        <result column="is_deleted" property="deleted"/>
        <result column="update_time" property="updateTime"/>
        <result column="form_id" property="formId"/>
        <result column="form_name" property="formName"/>
        <result column="form_pattern" property="formPattern"/>
        <result column="is_required" property="isRequired"/>
        <result column="tips" property="tips"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_time,
        shop_id,
        is_deleted,
        update_time, form_id, form_name, form_pattern, is_required, tips
    </sql>

    <!-- 通用查询映射结果 -->
    <resultMap id="MemberRegisterFormResultMap" type="com.medusa.gruul.account.model.vo.MemberRegisterFormVo">
        <result column="id" property="id"/>
        <result column="form_id" property="formId"/>
        <result column="form_name" property="formName"/>
        <result column="form_pattern" property="formPattern"/>
        <result column="is_required" property="isRequired"/>
        <result column="tips" property="tips"/>
    </resultMap>

    <select id="selectMemberRegisterForm" resultMap="MemberRegisterFormResultMap">
        select t.id,t.form_id,t.form_name,t.form_pattern,t.is_required,t.tips from t_member_register_form t
        where
        t.is_deleted = 0
        <if test="shopId != null and shopId != ''">
            AND t.shop_id = #{shopId}
        </if>
        ORDER BY
        t.create_time
        DESC
    </select>

    <select id="qryFormById" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from t_member_register_form t
        where
        t.is_deleted = 0
        <if test="shopId != null and shopId != ''">
            AND t.shop_id = #{shopId}
        </if>
        <if test="formId != null and formId != ''">
            AND t.form_id = #{formId}
        </if>
        ORDER BY
        t.create_time
        DESC
    </select>


</mapper>
