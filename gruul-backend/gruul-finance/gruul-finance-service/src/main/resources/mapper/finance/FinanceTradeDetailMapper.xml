<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.medusa.gruul.finance.mapper.FinanceTradeDetailMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.medusa.gruul.finance.api.entity.FinanceTradeDetail">
        <id column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_deleted" property="deleted"/>
        <result column="shop_id" property="shopId"/>
        <result column="trade_no" property="tradeNo"/>
        <result column="user_id" property="userId"/>
        <result column="user_name" property="userName"/>
        <result column="user_avatar_url" property="userAvatarUrl"/>
        <result column="type" property="type"/>
        <result column="amount" property="amount"/>
        <result column="source_id" property="sourceId"/>
        <result column="capital_flows" property="capitalFlows"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        create_time,
        update_time,
        is_deleted,
        id, shop_id, trade_no, user_id, user_name, user_avatar_url, type, status, amount, source_id, capital_flows
    </sql>
    <select id="getTradeVoByTime" resultType="com.medusa.gruul.order.api.model.TradeVo">
        SELECT
            count(id) as transaction_volume,
            SUM(amount) as turnover 
        FROM
            t_finance_trade_detail
        WHERE
            TYPE = 0
            AND create_time BETWEEN #{startTime} AND #{endTime}
    </select>
    <select id="getTradeVoGroupByDate" resultType="com.medusa.gruul.order.api.model.TradeLineVo">
        SELECT
            count(id) AS transaction_volume,
            SUM(amount) AS turnover,
            DATE(create_time) AS date
        FROM
            t_finance_trade_detail
        WHERE
            TYPE = 0
            AND create_time BETWEEN #{startTime} AND #{endTime}
        GROUP BY
            DATE(create_time)
        ORDER BY
            DATE(create_time)
    </select>

</mapper>
