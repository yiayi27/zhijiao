<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.medusa.gruul.sms.dao.mapper.SmsChannelMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.medusa.gruul.sms.api.model.vo.SmsChannelVo">
        <id column="id" property="id"/>
        <result column="shop_id" property="shopId"/>
        <result column="signature" property="signature"/>
        <result column="code" property="code"/>
        <result column="status" property="status"/>
        <result column="api_key" property="apiKey"/>
        <result column="api_secret" property="apiSecret"/>
        <result column="callback_url" property="callbackUrl"/>
        <result column="remark" property="remark"/>
        <result column="template_info" property="templateInfo" typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_List">
        p.id, p.shop_id, p.signature, p.code, p.status,
        p.api_key, p.api_secret, p.callback_url, p.remark, p.template_info, p.create_time
    </sql>

    <select id="selectChannelList" resultMap="BaseResultMap" parameterType="com.medusa.gruul.sms.api.model.param.SmsChannelParam">
        select
        <include refid="Base_List"/>
        from
        t_sms_channel p
        <where>
            p.is_deleted = 0
            <if test="smsChannelParam.signature != null and smsChannelParam.signature != ''">
                and p.signature LIKE CONCAT('%',#{smsChannelParam.signature},'%')
            </if>
            <if test="smsChannelParam.code != null and smsChannelParam.code != ''">
                and p.code LIKE CONCAT('%',#{smsChannelParam.code},'%')
            </if>
            <if test="smsChannelParam.apiKey != null and smsChannelParam.apiKey != ''">
                and p.api_key LIKE CONCAT('%',#{smsChannelParam.apiKey},'%')
            </if>
            <if test="smsChannelParam.apiSecret != null and smsChannelParam.apiSecret != ''">
                and r.api_secret LIKE CONCAT('%',#{smsChannelParam.apiSecret},'%')
            </if>
            <if test="smsChannelParam.status != null ">
                and p.status = #{smsChannelParam.status}
            </if>
        </where>
        order by
        p.create_time
        desc
    </select>

    <select id="getChannelById" resultMap="BaseResultMap" parameterType="java.lang.Long">
        select * from t_sms_channel p
        <where>
            p.is_deleted = 0
            and p.id = #{id}
        </where>
    </select>

</mapper>
